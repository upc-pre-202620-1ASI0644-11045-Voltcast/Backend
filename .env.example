# Database Configuration (MySQL 8.0)
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/tp1

# Azure only: set to true (Azure Database for MySQL requires TLS)
# DB_SSL=true

# Redis (Azure: rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0)
# Redis (rate limiting; optional in local development, the limiter is skipped when empty)
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=...

# SMTP Configuration (aiosmtplib)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...@gmail.com
SMTP_PASS='abcd efgh ijkl mnop'
SMTP_FROM=...@gmail.com

# Firebase Cloud Messaging (push): the service account JSON of the Firebase project, on ONE line
FIREBASE_CREDENTIALS_JSON=

# OneDrive of the company (a dedicated Microsoft account). Register the app in Azure (App registrations) with a Web redirect URI.
# MS_TENANT_ID: consumers (personal Microsoft account), common (any account) or the id of the tenant (work or school account)
# MS_REDIRECT_URI: the callback of THIS backend, HTTPS (http only for localhost)
# MS_CLIENT_SECRET expires within 24 months at most: note the renewal date
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ONEDRIVE_FOLDER: the folder of the account where the Excel files are left (default /VoltCast/datasets)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=consumers
MS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/onedrive/callback
TOKEN_ENCRYPTION_KEY=
# ONEDRIVE_FOLDER=/VoltCast/datasets

# First Supervisor (optional): created at startup if it does not exist yet
SEED_ADMIN_EMAIL=supervisor@company.com
SEED_ADMIN_PASSWORD=ChangeMe#123
SEED_ADMIN_NAME=Supervisor

# Task queue and file storage shared by the API and the worker (python -m worker etl | training).
# Locally they are folders under LOCAL_STORAGE_DIR (default: ./storage).
# LOCAL_STORAGE_DIR=storage
# Azure: with this set, the files go to a blob container and the tasks to Azure Storage Queues
# (etl-tasks and training-tasks), which have to exist already.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=voltcast
