# Database Configuration (MySQL 8.0)
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/tp1

# Azure only: set to true (Azure Database for MySQL requires TLS)
# DB_SSL=true

# Redis (Azure: rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0)
# Redis (rate limiting; optional in local development, the limiter is skipped when empty)
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=...

# SMTP Configuration (aiosmtplib)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...@gmail.com
SMTP_PASS='abcd efgh ijkl mnop'
SMTP_FROM=...@gmail.com

# Firebase Cloud Messaging (push): the service account JSON of the Firebase project, on ONE line
FIREBASE_CREDENTIALS_JSON=

# Google Drive of the company (a dedicated Google account). In Google Cloud: enable the Drive API, set the OAuth consent
# screen to External and publish it (in Testing the token expires after 7 days) and create a Web OAuth client.
# GOOGLE_REDIRECT_URI: the callback of THIS backend, HTTPS (http only for localhost); it must be one of the client's redirect URIs
# GOOGLE_DRIVE_FOLDER_ID: the folder where the Excel files are left (the end of its URL in Drive)
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/drive/callback
GOOGLE_DRIVE_FOLDER_ID=
TOKEN_ENCRYPTION_KEY=

# First Supervisor (optional): created at startup if it does not exist yet
SEED_ADMIN_EMAIL=supervisor@company.com
SEED_ADMIN_PASSWORD=ChangeMe#123
SEED_ADMIN_NAME=Supervisor

# Task queue and file storage shared by the API and the worker (python -m worker etl | training).
# Locally they are folders under LOCAL_STORAGE_DIR (default: ./storage).
# LOCAL_STORAGE_DIR=storage
# Azure: with this set, the files go to a blob container and the tasks to Azure Storage Queues
# (etl-tasks and training-tasks), which have to exist already.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=voltcast
